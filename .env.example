# Copy to .env (git-ignored) and fill in. Never commit real values.

# Supabase Postgres, from Project > Connect. No sslmode= or pgbouncer= parameters.
# Runtime: TRANSACTION pooler, port 6543.
DATABASE_URL=
# Prisma CLI (migrate, seed): SESSION pooler, port 5432.
DIRECT_URL=

# Auth.js. Generate with: bunx auth secret  (use a different value in production)
AUTH_SECRET=
# Only for running `next start` on localhost. Not needed with `next dev` or on Vercel.
# AUTH_TRUST_HOST=true

# Supabase Storage, server only. The service-role key must never get a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CERT_BUCKET=certificates

# Seed script only (local). Not needed on Vercel.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
